#!/bin/sh
# Template pre-commit hook — copied into each new repo's .git/hooks/ at
# `git init` time via `init.templateDir = ~/.config/git/template` in ~/.gitconfig.
#
# Role: run gitleaks on staged changes in repos that DON'T declare their own
# pre-commit. A lefthook-managed repo overwrites this file with lefthook's own
# hook, and runs gitleaks from its roster instead — that is fine.
#
# The `.mcp.json` placeholder check that used to be hand-written here is a rule in
# ~/.config/gitleaks/gitleaks.toml, so every gitleaks call applies it, not only this one.
#
# Bypass for a single commit: git commit --no-verify (only when you really need to)

set -e

# Fail loudly when gitleaks is absent rather than silently no-op'ing — a
# partially-provisioned machine should not commit unscanned code. On a synced
# machine gitleaks is on PATH (mise shims via .zshenv), so this never trips.
if ! command -v gitleaks > /dev/null 2>&1; then
  printf 'pre-commit: gitleaks not on PATH — cannot scan staged changes for secrets.\n' >&2
  printf '  Provision it with:  boom source  (or: mise install)\n' >&2
  printf '  Bypass for one commit (only if you are sure):  git commit --no-verify\n' >&2
  exit 1
fi

# The global config, spelled out rather than trusted to the environment: a git hook can
# run from an editor, an agent, or launchd, none of which read the interactive shell's
# exports. Absent, gitleaks falls back to its defaults — scanned, just without the extras.
cfg=${GITLEAKS_CONFIG:-$HOME/.config/gitleaks/gitleaks.toml}
if [ -f "$cfg" ]; then
  gitleaks git --staged --redact -v --no-banner --config "$cfg"
else
  gitleaks git --staged --redact -v --no-banner
fi
