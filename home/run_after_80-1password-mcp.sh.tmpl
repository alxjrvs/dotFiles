{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# The 1Password Environments MCP server, user-scoped. It ships INSIDE the desktop app as a
# stdio server, so there is nothing to install and nothing to authenticate (its human approval
# gate is at tool-call time). Registration lives in ~/.claude.json, which nothing tracks, so
# a fresh machine reproduces no MCP server at all; this converges the one.
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:$PATH"
mcp=/Applications/1Password.app/Contents/MacOS/1password-mcp
[ -x "$mcp" ] || exit 0
command -v claude > /dev/null 2>&1 || exit 0
command -v jq > /dev/null 2>&1 || exit 0
jq -e '.mcpServers["1password"]' "$HOME/.claude.json" > /dev/null 2>&1 && exit 0
claude mcp add --scope user 1password -- "$mcp"
{{ end -}}
