#!/bin/bash
# Homebrew bundle, re-run when the Brewfile changes. `--no-upgrade`: apply reconciles, never
# upgrades. Last, so a failing cask stops no other script.
# Brewfile hash: {{ include "dot_config/homebrew/Brewfile" | sha256sum }}
set -euo pipefail
eval "$(/opt/homebrew/bin/brew shellenv)"
brew bundle --no-upgrade --file="$HOME/.config/homebrew/Brewfile"
# Installed but not declared is drift, and removed. stdin is closed: a cask uninstaller may prompt.
brew bundle cleanup --force --file="$HOME/.config/homebrew/Brewfile" < /dev/null
