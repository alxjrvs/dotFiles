#!/bin/bash
# Homebrew bundle, re-run when the Brewfile changes. `--no-upgrade`: apply installs, never upgrades
# or uninstalls. Last but the Claude profiles, which need its Claude cask, so a failing cask stops
# no other script.
# Brewfile hash: {{ include "dot_config/homebrew/Brewfile" | sha256sum }}
set -euo pipefail
eval "$(/opt/homebrew/bin/brew shellenv)"
brew bundle --no-upgrade --file="$HOME/.config/homebrew/Brewfile"
