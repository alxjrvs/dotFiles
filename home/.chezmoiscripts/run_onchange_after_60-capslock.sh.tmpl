#!/bin/bash
# Loads the Caps Lock launchd agent (Library/LaunchAgents/com.alxjrvs.capslock.plist, managed),
# re-run when the plist changes. Mac-only by .chezmoiignore. bootout first so a changed plist is
# re-read; RunAtLoad applies the mapping now.
# plist hash: {{ include "Library/LaunchAgents/com.alxjrvs.capslock.plist" | sha256sum }}
set -euo pipefail
label=com.alxjrvs.capslock
launchctl bootout "gui/$(id -u)/$label" 2> /dev/null || true
launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/$label.plist"
