#!/bin/sh
# Claude Code rewrites this file in its own key order, so a managed copy is drift by the next
# session. Converge the declared keys (home/.chezmoitemplates/claude-settings.json, kept in the
# app's order; it is itself a template) into whatever is on disk and
# keep the rest, order included. A merge cannot retire a key: `del(.key)` here, once.
mine=$(
  cat << 'MINE'
{{ template "claude-settings.json" . }}
MINE
)
command -v jq > /dev/null 2>&1 || {
  printf '%s\n' "$mine"
  exit 0
}
{{ if ne .chezmoi.os "darwin" -}}
# The 1Password MCP is the desktop app's; a container has no app.
mine=$(printf '%s\n' "$mine" | jq 'del(.enabledPlugins["1password-mcp@oberon"])')
{{ end -}}
jq -s --argjson mine "$mine" '(add // {}) * $mine'
