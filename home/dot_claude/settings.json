{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GIT_AUTHOR_NAME": "Claude",
    "GIT_AUTHOR_EMAIL": "alxjrvs+claude@gmail.com",
    "GIT_COMMITTER_NAME": "Claude",
    "GIT_COMMITTER_EMAIL": "alxjrvs+claude@gmail.com",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "include.path",
    "GIT_CONFIG_VALUE_0": "~/.config/git/agent.gitconfig",
    "NINETY_API_TOKEN_COMMAND": "~/.local/bin/op-sa read op://claude-agent/gninety/credential",
    "NINETY_API_TOKEN": ""
  },
  "attribution": {
    "commit": "Co-Authored-By: alxjrvs <alxjrvs@gmail.com>",
    "pr": "Co-authored with alxjrvs."
  },
  "permissions": {
    "allow": [
      "Artifact",
      "WebSearch",
      "Bash(gh pr merge:*)",
      "Bash(gh stack merge:*)",
      "Bash(git stash:*)",
      "Bash(op --version)",
      "Bash(op item list:*)",
      "Bash(op run:*)",
      "Bash(op whoami)"
    ],
    "deny": [
      "Bash(security find-generic-password:*)",
      "Bash(op read:*)",
      "Bash(op item get:*)",
      "Bash(op document get:*)",
      "Bash(*op-sa read*)",
      "Bash(*op-sa item get*)",
      "Bash(*op-sa document get*)",
      "Bash(*op-sa inject*)",
      "Bash(git credential:*)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/hosts.yml)",
      "Bash(*/op *)",
      "Bash(*/security find-generic-password *)",
      "Bash(*/security find-internet-password *)",
      "Bash(*/security find-certificate *)",
      "Bash(*/security find-identity *)",
      "Bash(*/git credential *)",
      "Bash(*/git credential-store *)",
      "Bash(*/git credential-cache *)"
    ],
    "defaultMode": "auto"
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "op-sa *"
    ],
    "network": {
      "allowedDomains": [
        "api.github.com",
        "codeload.github.com",
        "github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "formulae.brew.sh",
        "ghcr.io",
        "pkg-containers.githubusercontent.com",
        "mise-versions.jdx.dev",
        "nodejs.org",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "rubygems.org"
      ],
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NINETY_API_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-freshness.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-port.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-freshness.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/verify-gate.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/op-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-remove-guard.sh",
            "if": "Bash(*git*)"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-remove-guard.sh",
            "if": "Bash(*rm*)"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/repo-scope-guard.sh",
            "if": "Bash(*gh*)"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/claude-statusline",
    "refreshInterval": 10
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.local/bin/claude-subagent-statusline"
  },
  "enabledPlugins": {
    "gninety@gnar": true,
    "typescript-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "gnar": {
      "source": {
        "source": "github",
        "repo": "TheGnarCo/agent-skills"
      },
      "autoUpdate": false
    },
    "oberon": {
      "source": {
        "source": "github",
        "repo": "alxjrvs/oberon"
      },
      "autoUpdate": false
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "auto",
  "skipWorkflowUsageWarning": true,
  "outputStyle": "Proactive",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "verbose": true,
  "showTurnDuration": false,
  "terminalProgressBarEnabled": false,
  "inputNeededNotifEnabled": true,
  "autoMode": {
    "classifyAllShell": true,
    "hard_deny": [
      "$defaults",
      "Never push directly to a repository's default branch, and never merge into it locally"
    ]
  },
  "autoMemoryEnabled": false,
  "askUserQuestionTimeout": "10m"
}
