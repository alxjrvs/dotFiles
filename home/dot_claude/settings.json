{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GIT_AUTHOR_NAME": "Claude",
    "GIT_AUTHOR_EMAIL": "alxjrvs+claude@gmail.com",
    "GIT_COMMITTER_NAME": "Claude",
    "GIT_COMMITTER_EMAIL": "alxjrvs+claude@gmail.com",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "include.path",
    "GIT_CONFIG_VALUE_0": "~/.config/git/agent.gitconfig",
    "NINETY_API_TOKEN_COMMAND": "~/.local/bin/op-sa read op://claude-agent/gninety/credential"
  },
  "attribution": {
    "commit": "Co-Authored-By: alxjrvs <alxjrvs@gmail.com>",
    "pr": "Co-authored with alxjrvs.",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Artifact",
      "WebSearch"
    ],
    "deny": [
      "Bash(*gh release create*)",
      "Bash(*gh gist create*)",
      "Bash(*gh alias*)",
      "Bash(*gh auth token*)",
      "Bash(*--show-token*)",
      "Bash(*op-sa *)",
      "Bash(*security find-generic-password*)",
      "Bash(*security find-internet-password*)",
      "Bash(*git credential*)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.netrc)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/claude-statusline",
    "refreshInterval": 10
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.local/bin/claude-subagent-statusline"
  },
  "enabledPlugins": {
    "agent-friendly-repo@oberon": true,
    "gninety@gnar": true,
    "typescript-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "toolkit@gnar": true
  },
  "extraKnownMarketplaces": {
    "gnar": {
      "source": {
        "source": "github",
        "repo": "TheGnarCo/agent-skills"
      }
    },
    "oberon": {
      "source": {
        "source": "github",
        "repo": "alxjrvs/oberon"
      }
    }
  },
  "outputStyle": "Proactive",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "api.github.com",
        "codeload.github.com",
        "github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "formulae.brew.sh",
        "ghcr.io",
        "pkg-containers.githubusercontent.com",
        "mise-versions.jdx.dev",
        "nodejs.org",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "rubygems.org"
      ],
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock",
        "~/.1password/agent.sock"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NINETY_API_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "enableWeakerNetworkIsolation": true
  },
  "askUserQuestionTimeout": "10m",
  "autoMemoryEnabled": false,
  "theme": "auto",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "verbose": true,
  "showTurnDuration": false,
  "terminalProgressBarEnabled": false,
  "inputNeededNotifEnabled": true,
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Never push directly to a repository's default branch, and never merge into it locally"
    ],
    "classifyAllShell": true
  }
}
