{{- /* chezmoi:modify-template */ -}}
{{- /*
  ~/.claude/settings.json is also written by Claude Code and the desktop app, so chezmoi owns
  only the keys declared in .chezmoitemplates/claude-settings.json and leaves the rest. A
  declared top-level key is replaced whole, except the two maps the app adds entries to, which
  are merged entry by entry. A declared null deletes its key or entry: how a key this repo once
  set is retired. A file already holding every declared value is left byte for byte.
*/ -}}
{{- $want := includeTemplate "claude-settings.json" . | fromJson -}}
{{- $have := dict -}}
{{- if .chezmoi.stdin }}{{ $have = fromJson .chezmoi.stdin }}{{ end -}}
{{- $next := deepCopy $have -}}
{{- range $key, $value := $want -}}
{{-   if kindIs "invalid" $value -}}
{{-     $_ := unset $next $key -}}
{{-   else if has $key (list "enabledPlugins" "extraKnownMarketplaces") -}}
{{-     $map := get $next $key -}}
{{-     if not (kindIs "map" $map) }}{{ $map = dict }}{{ $_ := set $next $key $map }}{{ end -}}
{{-     range $entry, $entryValue := $value -}}
{{-       if kindIs "invalid" $entryValue }}{{ $_ := unset $map $entry }}{{ else }}{{ $_ := set $map $entry $entryValue }}{{ end -}}
{{-     end -}}
{{-   else -}}
{{-     $_ := set $next $key $value -}}
{{-   end -}}
{{- end -}}
{{- if eq (toJson $next) (toJson $have) -}}
{{-   .chezmoi.stdin -}}
{{- else -}}
{{-   toPrettyJson "  " $next }}
{{ end -}}
