{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# tealdeer ships no pages; fetch the archive once so `tldr <cmd>` works on a fresh machine.
# `|| true`: an offline first apply must not fail on a cache.
set -euo pipefail
export PATH="$HOME/.local/share/mise/shims:$PATH"
command -v tldr > /dev/null 2>&1 || exit 0
tldr --update || true
{{ end -}}
