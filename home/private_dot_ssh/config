Host *
  # Keys live in 1Password; touch to sign. Needs "SSH agent" on in 1Password → Developer.
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

  ServerAliveInterval 60
  ServerAliveCountMax 3

  # Multiplexing, sockets under the private ~/.ssh/cm rather than /tmp.
  ControlMaster auto
  ControlPath ~/.ssh/cm/%C
  ControlPersist 4h
