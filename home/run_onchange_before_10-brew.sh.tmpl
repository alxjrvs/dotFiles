{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Homebrew: the bootstrap for everything else (mise, chezmoi itself, casks). Re-runs only when
# the Brewfile changes, via the hash below — chezmoi's documented idiom for a package list.
# Brewfile hash: {{ include "dot_config/homebrew/Brewfile" | sha256sum }}
#
# `--no-upgrade`, always: reconciling means "what is declared is installed", never "what is
# installed is current". `brew upgrade --formula` moves formulae without closing an app; casks
# are left to their own updaters. The Brewfile header carries the cadence.
#
# `before`: this runs ahead of file placement, so the Brewfile is read from the SOURCE path,
# which exists on a fresh machine before any symlink does.
set -euo pipefail
if ! command -v brew > /dev/null 2>&1; then
  [ -x /opt/homebrew/bin/brew ] || /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
brew bundle --no-upgrade --file="{{ .chezmoi.sourceDir }}/dot_config/homebrew/Brewfile"
{{ end -}}
