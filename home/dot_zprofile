# Login shells. PATH goes here, after /etc/zprofile's path_helper has rebuilt it from scratch.
# No GitHub token and no SSH_AUTH_SOCK: gh and git resolve credentials on demand, and signing
# and ssh both go through the 1Password agent. brew shellenv also exports FPATH.
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
typeset -U path PATH
path=("$HOME/.local/bin" $path)
# Shims for programs that never read ~/.zshrc (editors, agents); ~/.zshrc activates for the
# interactive shell on top. mise's documented split. Every CLI is a mise tool, so this is PATH.
(( $+commands[mise] )) && eval "$(mise activate zsh --shims)"
