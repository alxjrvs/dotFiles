# Login shells. PATH goes here, after /etc/zprofile's path_helper has rebuilt it from scratch.
# No GitHub token and no SSH_AUTH_SOCK: gh and git resolve credentials on demand, and signing
# and ssh both go through the 1Password agent.
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
export XDG_CONFIG_HOME="$HOME/.config"
typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/.local/share/mise/shims" $path)
