[Desktop Entry]
Type=Application
Name=Steam
Comment=Application for managing and playing games on Steam
# -pipewire lets Remote Play capture the KDE Wayland desktop; without it a client sees black
# wherever the game window isn't (launchers, menus, the gap before a game draws).
Exec=/usr/bin/steam -pipewire %U
Icon=steam
Terminal=false
Categories=Network;FileTransfer;Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true
