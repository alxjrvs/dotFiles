{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GIT_AUTHOR_NAME": "Claude",
    "GIT_AUTHOR_EMAIL": "alxjrvs+claude@gmail.com",
    "GIT_COMMITTER_NAME": "Claude",
    "GIT_COMMITTER_EMAIL": "alxjrvs+claude@gmail.com",
    "GIT_CONFIG_COUNT": "3",
    "GIT_CONFIG_KEY_0": "commit.gpgSign",
    "GIT_CONFIG_VALUE_0": "false",
    "GIT_CONFIG_KEY_1": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_1": "git@github.com:",
    "GIT_CONFIG_KEY_2": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_2": "ssh://git@github.com/",
    "NINETY_API_TOKEN_COMMAND": "op read --account my.1password.com op://claude-agent/gninety/credential"
  },
  "attribution": {
    "commit": "Co-Authored-By: alxjrvs <alxjrvs@gmail.com>",
    "pr": "Co-authored with alxjrvs.",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Artifact",
      "WebSearch",
      "WebFetch(domain:*)"
    ],
    "deny": [
      "Bash(*gh release create*)",
      "Bash(*gh gist create*)",
      "Bash(*gh auth token*)",
      "Bash(*security find-generic-password*)",
      "Bash(*git credential*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/claude-statusline",
    "refreshInterval": 10
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.local/bin/claude-subagent-statusline"
  },
  "enabledPlugins": {
    "agent-friendly-repo@oberon": true,
    "gninety@gnar": true,
    "typescript-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "toolkit@gnar": true,
    "1password-mcp@oberon": true
  },
  "extraKnownMarketplaces": {
    "gnar": {
      "source": {
        "source": "github",
        "repo": "TheGnarCo/agent-skills"
      }
    },
    "oberon": {
      "source": {
        "source": "github",
        "repo": "alxjrvs/oberon"
      }
    }
  },
  "outputStyle": "Proactive",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock",
        "~/.1password/agent.sock"
      ],
      "allowMachLookup": [
        "com.apple.trustd.agent"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "askUserQuestionTimeout": "10m",
  "autoMemoryEnabled": false,
  "theme": "auto",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "verbose": true,
  "showTurnDuration": false,
  "terminalProgressBarEnabled": false,
  "inputNeededNotifEnabled": true,
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Never push directly to a repository's default branch, and never merge into it locally"
    ],
    "classifyAllShell": true
  }
}
