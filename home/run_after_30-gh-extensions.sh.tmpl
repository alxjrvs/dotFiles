{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# gh extensions: one owner-qualified ref per line in gh-extensions.txt at the repo root.
# Installs only the misses and never upgrades, matching gh's own behaviour; scripts/verify.sh
# diffs the same file against `gh extension list`, so a hand-removed extension is drift.
#
# Every apply, not `onchange`: `gh extension list` needs an authenticated gh, and on a fresh
# machine `gh auth login` comes after the first apply. An onchange script that exits 0 there
# would record its hash and never retry; a cheap every-apply script simply succeeds next time.
set -euo pipefail
export PATH="$HOME/.local/share/mise/shims:/opt/homebrew/bin:$PATH"
command -v gh > /dev/null 2>&1 || { echo "gh-extensions: gh is not on PATH yet — skipping" >&2; exit 0; }
gh auth status > /dev/null 2>&1 || { echo "gh-extensions: gh is not authenticated — run \`gh auth login\`, then \`chezmoi apply\`" >&2; exit 0; }
installed=$(gh extension list 2> /dev/null | awk '{print $3}')
while IFS= read -r line; do
  ref=$(printf '%s' "${line%%#*}" | tr -d '[:space:]')
  [ -n "$ref" ] || continue
  printf '%s\n' "$installed" | grep -qx "$ref" || gh extension install "$ref"
done < "{{ .chezmoi.workingTree }}/gh-extensions.txt"
{{ end -}}
