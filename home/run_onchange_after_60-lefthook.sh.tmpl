#!/bin/bash
# lefthook owns .git/hooks in this checkout. Re-run when its config changes so the generated
# hook's checksum stays current. No "missing lefthook" guard: mise (20) installs it earlier in
# the same apply, and an onchange script that exited 0 without it would not retry until
# lefthook.yml next changed.
# lefthook.yml hash: {{ include "../lefthook.yml" | sha256sum }}
set -euo pipefail
export PATH="$HOME/.local/share/mise/shims:$PATH"
cd "{{ .chezmoi.workingTree }}" && lefthook install
