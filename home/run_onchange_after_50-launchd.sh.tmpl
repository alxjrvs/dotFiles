{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# LaunchAgents: (re)load each managed plist when its content changes. `bootout` then
# `bootstrap` is the modern pair; the bootout is allowed to fail on a job not loaded yet.
# capslock plist hash: {{ include "Library/LaunchAgents/com.alxjrvs.capslock-control.plist" | sha256sum }}
# verify plist hash (rendered, so a changed repo path re-loads the job): {{ includeTemplate "Library/LaunchAgents/com.alxjrvs.dotfiles-verify.plist.tmpl" . | sha256sum }}
set -euo pipefail
domain="gui/$(id -u)"
for label in com.alxjrvs.capslock-control com.alxjrvs.dotfiles-verify; do
  plist="$HOME/Library/LaunchAgents/$label.plist"
  [ -f "$plist" ] || { echo "launchd: $plist is missing" >&2; exit 1; }
  launchctl bootout "$domain/$label" 2> /dev/null || true
  launchctl bootstrap "$domain" "$plist"
done
{{ end -}}
