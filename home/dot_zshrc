# ~/.zshrc: interactive shells, where mise activate takes over from ~/.zshenv's shims. Every tool
# is guarded, so a machine that lacks one still gets a working prompt.
# A non-interactive shell that sources this (Claude Code's shell snapshot) stops here: it would
# freeze PATH as activated for one directory, and the shims already resolve per directory.
[[ -o interactive ]] || return

(( $+commands[mise] )) && eval "$(mise activate zsh)"

# --- options -----------------------------------------------------------------------------------
setopt AUTO_CD CORRECT INTERACTIVE_COMMENTS NO_BEEP NO_FLOWCONTROL
# History: atuin is the source of truth and the only cross-session index, so append, never
# share. macOS's /etc/zshrc names the file.
HISTSIZE=10000
SAVEHIST=10000
setopt INC_APPEND_HISTORY_TIME HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_VERIFY EXTENDED_HISTORY HIST_REDUCE_BLANKS
# What atuin's history_filter keeps out of its database stays out of the history file too.
_history_filter() {
  setopt local_options extended_glob
  [[ $1 != (#i)*(password|secret|token|apikey|api(|_|-)key)[[:space:]]#[:=]* &&
    $1 != (|*[^[:alnum:]_])sk-[[:alnum:]_-](#c20,)* ]] || return 2
}
autoload -Uz add-zsh-hook && add-zsh-hook zshaddhistory _history_filter

# --- vi mode -----------------------------------------------------------------------------------
bindkey -v
KEYTIMEOUT=1
# /etc/zshrc binds Home, End and Delete in emacs mode only, so vi mode binds them here, in the
# application-mode form below. Ghostty's macOS defaults send ^A/^E for Cmd-Left/Right, Esc-b/f for
# Option-Left/Right and Esc-DEL for Option-Delete.
for m (viins vicmd) {
  (( ${+terminfo[khome]} )) && bindkey -M $m "$terminfo[khome]" beginning-of-line \
    "$terminfo[kend]" end-of-line "$terminfo[kdch1]" delete-char
  bindkey -M $m '^A' beginning-of-line '^E' end-of-line '^[b' backward-word '^[f' forward-word \
    '^[^?' backward-kill-word
}
zle-line-init()   { (( ${+terminfo[smkx]} )) && printf '%s' ${terminfo[smkx]} }
zle-line-finish() { (( ${+terminfo[rmkx]} )) && printf '%s' ${terminfo[rmkx]} }
zle -N zle-line-init
zle -N zle-line-finish

# --- environment -------------------------------------------------------------------------------
# BAT_THEME is what delta, MANPAGER and the fzf preview read; bat's config file is not.
export EDITOR=nvim BAT_THEME=Nord BAT_PAGING=never
# col strips mandoc's overstrikes; man pages page even though bat itself does not.
(( $+commands[bat] )) && export MANPAGER="sh -c 'col -bx | bat -plman --paging=always'"

# --- plugins: two Brewfile formulae; `source` is the plugin manager ---------------------------
_zsh_plugins=/opt/homebrew/share
_zsh_plugin=$_zsh_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
# Bind once: syntax highlighting 0.8 hooks zle-line-pre-redraw and wraps no widget to outlive.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
[[ -r $_zsh_plugin ]] && source $_zsh_plugin

# --- completion: brew shellenv (~/.zprofile) already put site-functions on fpath -------------
autoload -Uz compinit
compinit -i # an insecure site-functions directory must not block every new shell on y/n
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*:git-checkout:*' sort false

# --- tools -------------------------------------------------------------------------------------
if (( $+commands[fzf] )); then
  export FZF_DEFAULT_OPTS='--layout=reverse --border --height=40%'
  # fzf's walker ignores .gitignore, so fd lists; the walker is the fallback without fd.
  (( $+commands[fd] )) && export FZF_CTRL_T_COMMAND='fd --type f --hidden --follow'
  export FZF_CTRL_T_OPTS="--walker=file,follow,hidden --preview 'bat --color=always {}' --preview-window right:50%"
  eval "$(fzf --zsh)"
fi
if (( $+commands[atuin] )); then
  # Up/Down stay plain history, and `?` stays a character. In vicmd atuin binds `/`, so Ctrl-R
  # there is ours.
  eval "$(atuin init zsh --disable-up-arrow --disable-ai)"
  bindkey -M vicmd '^R' atuin-search-vicmd
fi
(( $+commands[starship] )) && eval "$(starship init zsh)"
# zoxide adds `z` and `zi` and a chpwd hook; `cd` stays zsh's, so the two never compete.
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# --- aliases -----------------------------------------------------------------------------------
alias gs='git status' gp='git push' gpr='git pull --rebase' gco='git checkout'
# Long lines are cut for a person's screen only; an agent's rg sees every match.
alias rg='rg --max-columns=200 --max-columns-preview'
(( $+commands[nvim] )) && alias vim='nvim'

# --- syntax highlighting: last, because it wraps the ZLE widgets defined above ----------------
_zsh_plugin=$_zsh_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
[[ -r $_zsh_plugin ]] && source $_zsh_plugin
unset _zsh_plugin _zsh_plugins m
