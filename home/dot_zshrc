# ~/.zshrc: interactive shells, kept near stock. This Mac is driven from the Claude desktop app,
# which reads its agents' PATH from an interactive login shell, so nothing here slows or bends that.
# ~/.zshenv's mise shims serve every shell, this one included: a `mise activate` here would pin
# every agent to one directory's versions. A non-interactive shell that sources this stops here.
[[ -o interactive ]] || return

# History: atuin is the one store (Ctrl-R, every session) and its secrets_filter guards it, so zsh
# keeps this session's lines in memory and writes no file for a token to land in.
unset HISTFILE
HISTSIZE=10000
setopt HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_VERIFY HIST_REDUCE_BLANKS

export EDITOR=nvim

(( $+commands[atuin] )) && eval "$(atuin init zsh --disable-up-arrow --disable-ai)"
