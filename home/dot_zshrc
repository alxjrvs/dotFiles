# ~/.zshrc: interactive shells. Login-shell PATH lives in ~/.zprofile. Every tool is guarded, so
# the same file degrades to a plain prompt on a host that has none of them.

(( $+commands[mise] )) && eval "$(mise activate zsh)"

# --- options -----------------------------------------------------------------------------------
setopt CORRECT EXTENDED_GLOB INTERACTIVE_COMMENTS NO_BEEP NO_FLOWCONTROL
# History: atuin is the source of truth; the native file covers arrow-key recall only.
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_VERIFY EXTENDED_HISTORY HIST_REDUCE_BLANKS

# --- vi mode -----------------------------------------------------------------------------------
bindkey -v
KEYTIMEOUT=1
# Cursor: steady block in normal mode, blinking bar in insert (DECSCUSR 2 / 5).
zle-keymap-select() { if [[ $KEYMAP == vicmd ]]; then print -n '\e[2 q'; else print -n '\e[5 q'; fi }
zle-line-init() { print -n '\e[5 q'; }
zle -N zle-keymap-select
zle -N zle-line-init

# --- environment -------------------------------------------------------------------------------
# LANG: what the terminal set, else the UTF-8 locale every libc ships (en_US is absent from
# most images, and zsh's setlocale fails silently).
export EDITOR=nvim VISUAL=nvim LANG=${LANG:-C.UTF-8} LESS='-RFX'
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"
export GH_PAGER=delta # env, not gh's config.yml: gh rewrites that file, so it is not managed
(( $+commands[bat] )) && export MANPAGER="bat -plman"

# --- plugins: two, chezmoi externals; `source` is the plugin manager --------------------------
_zsh_plugins=$HOME/.local/share/zsh/plugins
_zsh_plugin=$_zsh_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -r $_zsh_plugin ]] && source $_zsh_plugin

# --- completion: brew shellenv (~/.zprofile) already put site-functions on fpath -------------
autoload -Uz compinit
compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*:git-checkout:*' sort false

# --- tools -------------------------------------------------------------------------------------
if (( $+commands[fzf] )); then
  export FZF_DEFAULT_OPTS='--layout=reverse --border --height=40%'
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow'
  export FZF_CTRL_T_OPTS="--preview 'bat --color=always {}' --preview-window right:50%"
  export FZF_ALT_C_OPTS="--preview 'eza --icons -T {} | head -20'"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow'
  eval "$(fzf --zsh)"
fi
if (( $+commands[atuin] )); then
  # --disable-up-arrow keeps Up/Down as plain history navigation. atuin's init takes Ctrl-R from
  # fzf in emacs and viins; in vicmd it binds `/`, so Ctrl-R there is ours.
  eval "$(atuin init zsh --disable-up-arrow)"
  bindkey -M vicmd '^R' atuin-search
fi
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
(( $+commands[starship] )) && eval "$(starship init zsh)"

# --- aliases -----------------------------------------------------------------------------------
alias gs='git status' gp='git push' gpr='git pull --rebase' gco='git checkout' gd='git diff'
alias ..='cd ..'
(( $+commands[eza] )) && alias ls='eza --icons --group-directories-first'
(( $+commands[nvim] )) && alias vim='nvim'

# --- syntax highlighting: last, because it wraps the ZLE widgets defined above ----------------
_zsh_plugin=$_zsh_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
[[ -r $_zsh_plugin ]] && source $_zsh_plugin
unset _zsh_plugin _zsh_plugins
