# ~/.zshrc: interactive shells, kept near stock. This Mac is driven from the Claude desktop app,
# which reads its agents' PATH from an interactive login shell, so nothing here slows or bends that.
# ~/.zshenv's mise shims serve every shell, this one included: a `mise activate` here would pin
# every agent to one directory's versions. A non-interactive shell that sources this stops here.
[[ -o interactive ]] || return

# History: plain zsh, in the file macOS's /etc/zshrc names. A line holding a secret stays out of it:
# a `key: value` or `key=value` secret, the token prefixes of GitHub, AWS, Slack, GitLab, Stripe,
# npm, OpenAI, Anthropic and 1Password, and a password in a URL. A leading space skips one line.
HISTSIZE=10000
SAVEHIST=10000
setopt INC_APPEND_HISTORY_TIME HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_VERIFY EXTENDED_HISTORY HIST_REDUCE_BLANKS
_history_filter() {
  setopt local_options extended_glob
  [[ $1 != (#i)*(password|secret|token|apikey|api(|_|-)key)[[:space:]]#[:=]* &&
    $1 != *(gh[pousr]_[[:alnum:]](#c36)|github_pat_[[:alnum:]_](#c22,)|AKIA[[:upper:][:digit:]](#c16)|xox[abprs]-|glpat-|[rs]k_(live|test)_|npm_[[:alnum:]](#c36))* &&
    $1 != (|*[^[:alnum:]_])(sk|ops)[-_][[:alnum:]_-](#c20,)* &&
    $1 != *://[^/[:space:]:@]##:[^/[:space:]@]##@* ]] || return 2
}
autoload -Uz add-zsh-hook && add-zsh-hook zshaddhistory _history_filter
