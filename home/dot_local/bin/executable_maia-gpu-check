#!/bin/bash
# Is the R9700 doing the work? ROCm sees gfx1201, and Ollama runs its loaded models on the GPU.
# Read-only; fails when either is missing.
set -uo pipefail
failed=

echo "== rocminfo (the card, as ROCm sees it)"
if ! rocminfo 2> /dev/null | grep -m 1 gfx1201; then
  echo "no gfx1201: is $USER in render and video (log out and in after setup), and is the card in?" >&2
  failed=1
fi

echo "== ollama ps (PROCESSOR should read 100% GPU)"
if ! ollama ps; then
  echo "ollama is not answering: systemctl status ollama" >&2
  failed=1
fi
echo "(nothing listed? load one first: ollama run <model> hello)"

[ -z "$failed" ]
