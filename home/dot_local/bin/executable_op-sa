#!/bin/sh
# op-sa: `op` as the agent's 1Password service account, for the plugin tokens that are not
# GitHub's. The token is loaded into this process only, from the login keychain (item
# `op-claude-agent`; see the README). Its consumers are the token commands in
# ~/.claude/settings.json, never an agent's Bash: an `op-sa` invocation is text-denied there.
# Mac-only by .chezmoiignore: a container's secrets are its environment's own.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
OP_SERVICE_ACCOUNT_TOKEN="$(security find-generic-password -s op-claude-agent -w)" || exit 1
export OP_SERVICE_ACCOUNT_TOKEN
exec op "$@"
