#!/bin/bash
# Homebrew bundle, re-run when the Brewfile changes. `--no-upgrade`: apply reconciles, never
# upgrades. `after`: files land first, so a bundle that stops on a prompt leaves the shell usable.
# Brewfile hash: {{ include "dot_config/homebrew/Brewfile" | sha256sum }}
set -euo pipefail
eval "$(/opt/homebrew/bin/brew shellenv)"
brew bundle --no-upgrade --file="{{ .chezmoi.sourceDir }}/dot_config/homebrew/Brewfile"
