<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly `mise run upkeep`, what apply never does. A failure opens an issue in
     alxjrvs/dotFiles, which reaches the phone; the log alone went unread (#242). launchd expands
     no `~` (#116), so the paths are the shell's $HOME. A run missed asleep runs at wake.
     Loaded by .chezmoiscripts/25-launchagents.sh when this file changes. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alxjrvs.upkeep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>log=$HOME/Library/Logs/upkeep.log; mise run upkeep &gt; "$log" 2&gt;&amp;1 || gh issue create --repo alxjrvs/dotFiles --title "upkeep failed on $(scutil --get LocalHostName)" --body "$(tail -c 60000 "$log")"</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>17</integer>
  </dict>
</dict>
</plist>
