<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.alxjrvs.capslock-control</string>
	<!-- Caps Lock → Left Control, natively, via hidutil (no Karabiner kernel
	     extension). Src 0x700000039 = Caps Lock, Dst 0x7000000E0 = Left Control
	     (USB HID usage IDs, page 0x07). hidutil remaps do NOT survive a reboot
	     or a keyboard reconnect, so RunAtLoad re-applies it every login — the
	     reproducible, declarative equivalent of the System Settings toggle. -->
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/hidutil</string>
		<string>property</string>
		<string>--set</string>
		<string>{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x7000000E0}]}</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- No StandardOutPath/StandardErrorPath. They pointed at a predictable
	     filename in /tmp, which is world-writable and a symlink-plant surface —
	     the same hazard ssh/config avoids by putting ControlPath sockets under
	     ~/.ssh/cm. They could not simply move: launchd does NOT expand ~ or
	     $HOME in plist values, and a ~-prefixed log path failed this job with
	     EX_CONFIG (78) before it could run hidutil, silently breaking the
	     Caps→Control remap. The right answer was not to log: hidutil prints the
	     resulting dict on success, which is noise, and launchd already records
	     the exit status of a failure. -->
</dict>
</plist>
