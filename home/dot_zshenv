# ~/.zshenv: read by every zsh, including the ones no shell parents: launchd, cron, an editor's
# task runner. The literal paths, not `mise activate --shims` or `brew shellenv`: no process per
# script.
typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/.local/share/mise/shims" /opt/homebrew/bin $path)
# rg reads a config only through this variable, so every zsh exports it: an agent's rg too.
export RIPGREP_CONFIG_PATH=$HOME/.ripgreprc
