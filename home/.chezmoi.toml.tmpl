# Rendered by `chezmoi init` (`chezmoi apply --init` after editing). sourceDir pins the checkout
# where `init --source` put it; workingTree, because under `.chezmoiroot` sourceDir is `home/`.
sourceDir = {{ .chezmoi.workingTree | quote }}

# An every-apply script is not drift.
[verify]
    exclude = ["always"]
[status]
    exclude = ["always"]
