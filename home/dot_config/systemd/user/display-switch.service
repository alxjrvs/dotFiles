# The monitor follows the dock (~/.config/display-switch/display-switch.ini). Enabled by the maia
# setup script once maia.dockUsb is measured; DDC needs the i2c group, so it starts working from the
# first login after the setup added it.
[Unit]
Description=display-switch: the monitor follows the dock

[Service]
ExecStart=%h/.local/bin/display_switch
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
