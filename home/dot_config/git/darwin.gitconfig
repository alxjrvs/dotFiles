# macOS half of ~/.config/git/config, included from there. Absent on Linux, and git ignores a
# missing include, so nothing here needs a guard.

# Commits and tags signed with the 1Password SSH key, behind Touch ID.
[commit]
	gpgSign = true
[tag]
	gpgSign = true
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

# Hosts other than GitHub: the login keychain.
[credential]
	helper = osxkeychain
