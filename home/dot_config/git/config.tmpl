# ~/.config/git/config, one template. On a Mac the empty helper resets the list Apple's bundled
# gitconfig starts with osxkeychain, for every host: gh alone serves github.com, and inside the
# Claude Code sandbox git no longer offers the proxy's credentials to a keychain it cannot write.
{{ if eq .chezmoi.os "darwin" -}}
# A Mac signs with the 1Password app's SSH key, authorised once per application per unlock;
# a container signs nothing.
[commit]
	gpgSign = true
[tag]
	gpgSign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[user]
	# The public half of the 1Password "GitHubSSH" item.
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKjF9JmW396EbH0n1zWeU7eT+2VvMFZAn+A1WKAi4tqT
[credential]
	helper =

{{ end -}}
[user]
	name = alxjrvs
	email = alxjrvs@gmail.com
# github.com through gh's token (what `gh auth setup-git` writes).
[credential "https://github.com"]
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = !gh auth git-credential
[core]
	editor = nvim
	pager = delta
	untrackedCache = true

[init]
	defaultBranch = main
[commit]
	verbose = true
[push]
	autoSetupRemote = true
	followTags = true
	useForceIfIncludes = true
[pull]
	rebase = true
[rerere]
	enabled = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	dark = true
	hyperlinks = true
[fetch]
	prune = true
	all = true
	writeCommitGraph = true
[gc]
	# Agent worktrees churn daily; forget a hand-deleted one after a week, not three months.
	worktreePruneExpire = 1.week.ago

[merge]
	conflictstyle = zdiff3
[branch]
	sort = -committerdate
[column]
	ui = auto
[diff]
	algorithm = histogram
	colorMoved = dimmed-zebra
	mnemonicPrefix = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
	missingCommitsCheck = error
[tag]
	sort = version:refname
[help]
	autocorrect = prompt

# A repo in a work org (.chezmoidata.toml) commits as work. hasconfig matches case-sensitively,
# so each org is listed as written and in lower case.
{{- range .workOrgs }}
{{- range list . (lower .) | uniq }}
[includeIf "hasconfig:remote.*.url:https://github.com/{{ . }}/**"]
	path = work
[includeIf "hasconfig:remote.*.url:git@github.com:{{ . }}/**"]
	path = work
{{- end }}
{{- end }}
