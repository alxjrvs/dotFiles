{{- /* gh and 1Password's signer, where each OS's installer puts them. */ -}}
{{- $gh := "/opt/homebrew/bin/gh" -}}
{{- $sign := "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $gh = "/usr/bin/gh" -}}
{{-   $sign = "/opt/1Password/op-ssh-sign" -}}
{{- else if eq .chezmoi.os "windows" -}}
{{-   $gh = "'C:/Program Files/GitHub CLI/gh.exe'" -}}
{{-   $sign = printf "%s/AppData/Local/1Password/app/8/op-ssh-sign.exe" .chezmoi.homeDir | replace "\\" "/" -}}
{{- end -}}
# The empty helper drops the one the system gitconfig starts with (Apple's osxkeychain, Git for
# Windows' manager), so gh's token is the only credential git keeps, for every form of GitHub URL.
# gh by absolute path, as `gh auth setup-git` writes it: a launchd job's git has no Homebrew on PATH.
[credential]
	helper =
[credential "https://github.com"]
	helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
	helper = !{{ $gh }} auth git-credential
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
[user]
	name = {{ .name }}
	email = {{ .email }}
	# The public half of the 1Password "{{ .signingItem.item }}" item.
	signingkey = key::{{ .signingKey }}
[gpg]
	format = ssh
[gpg "ssh"]
	program = {{ $sign }}
[commit]
	gpgSign = true
	verbose = true
[tag]
	gpgSign = true
	sort = version:refname
[core]
	untrackedCache = true

[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
	followTags = true
	useForceIfIncludes = true
[pull]
	rebase = true
[rerere]
	enabled = true
[fetch]
	prune = true
	all = true
	writeCommitGraph = true
[gc]
	# Agent worktrees churn daily; forget a hand-deleted one after a week, not three months.
	worktreePruneExpire = 1.week.ago
[maintenance "worktree-prune"]
	# Auto-maintenance after a commit or fetch applies that week; no scheduler, no `maintenance start`.
	enabled = true

[merge]
	conflictstyle = zdiff3
[branch]
	sort = -committerdate
[column]
	ui = auto
[diff]
	algorithm = histogram
	colorMoved = dimmed-zebra
	mnemonicPrefix = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
	missingCommitsCheck = error
[help]
	autocorrect = prompt

# A repo in a work org (.chezmoidata.toml) commits as work, over any GitHub URL form. hasconfig
# matches case-sensitively, so each org is listed as written and in lower case.
{{- range .workOrgs }}
{{- range list . (lower .) | uniq }}
[includeIf "hasconfig:remote.*.url:**/*github.com/{{ . }}/**"]
	path = work
[includeIf "hasconfig:remote.*.url:*github.com:{{ . }}/**"]
	path = work
{{- end }}
{{- end }}
