# The empty helper drops the osxkeychain helper Apple's system gitconfig starts with, so gh's
# token is the only credential git keeps.
[credential]
	helper =
[credential "https://github.com"]
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = !gh auth git-credential
[user]
	name = alxjrvs
	email = alxjrvs@gmail.com
	# The public half of the 1Password "GitHubSSH" item.
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKjF9JmW396EbH0n1zWeU7eT+2VvMFZAn+A1WKAi4tqT
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgSign = true
	verbose = true
[tag]
	gpgSign = true
	sort = version:refname
[core]
	editor = nvim
	pager = delta
	untrackedCache = true

[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
	followTags = true
	useForceIfIncludes = true
[pull]
	rebase = true
[rerere]
	enabled = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	dark = true
	hyperlinks = true
[fetch]
	prune = true
	all = true
	writeCommitGraph = true
[gc]
	# Agent worktrees churn daily; forget a hand-deleted one after a week, not three months.
	worktreePruneExpire = 1.week.ago

[merge]
	conflictstyle = zdiff3
[branch]
	sort = -committerdate
[column]
	ui = auto
[diff]
	algorithm = histogram
	colorMoved = dimmed-zebra
	mnemonicPrefix = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
	missingCommitsCheck = error
[help]
	autocorrect = prompt

# A repo in a work org (.chezmoidata.toml) commits as work, over any GitHub URL form. hasconfig
# matches case-sensitively, so each org is listed as written and in lower case.
{{- range .workOrgs }}
{{- range list . (lower .) | uniq }}
[includeIf "hasconfig:remote.*.url:**/*github.com/{{ . }}/**"]
	path = work
[includeIf "hasconfig:remote.*.url:*github.com:{{ . }}/**"]
	path = work
{{- end }}
{{- end }}
