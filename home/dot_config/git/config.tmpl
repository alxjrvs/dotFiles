# ~/.config/git/config, one template. The Mac-only block comes first so the github.com helper
# below can sever it: an empty helper resets the list, and gh alone serves GitHub.
{{ if eq .chezmoi.os "darwin" -}}
# macOS: commits and tags signed with the 1Password SSH key, behind Touch ID; hosts other than
# GitHub use the login keychain. A container signs nothing and has no keychain.
[commit]
	gpgSign = true
[tag]
	gpgSign = true
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[credential]
	helper = osxkeychain

{{ end -}}
[alias]
  hist = log --oneline --graph --decorate
  sw = switch
  st = status -sb
  undo = reset HEAD~1 --mixed

[user]
	name = alxjrvs
	email = alxjrvs@gmail.com
	# The public half of the 1Password "GitHubSSH" item; ~/.ssh/allowed_signers has it too.
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKjF9JmW396EbH0n1zWeU7eT+2VvMFZAn+A1WKAi4tqT
# github.com through gh's token (what `gh auth setup-git` writes).
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[core]
	editor = nvim
	pager = delta
	untrackedCache = true

[init]
	defaultBranch = main
[commit]
	verbose = true
[push]
	autoSetupRemote = true
	followTags = true
	useForceIfIncludes = true
[pull]
	rebase = true
[rerere]
	enabled = true
	autoupdate = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	dark = true
	hyperlinks = true
[fetch]
	prune = true
	writeCommitGraph = true
[gc]
	# Agent worktrees churn daily; forget a hand-deleted one after a week, not three months.
	worktreePruneExpire = 1.week.ago

[merge]
	conflictstyle = zdiff3
[branch]
	sort = -committerdate
[column]
	ui = auto
[diff]
	algorithm = histogram
	colorMoved = dimmed-zebra
	mnemonicPrefix = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[tag]
	sort = version:refname
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[help]
	autocorrect = prompt
