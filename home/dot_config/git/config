[include]
	# macOS only: signing and the keychain helper. Absent on Linux; git ignores a missing include.
	path = darwin.gitconfig

[alias]
  hist = log --oneline --graph --decorate
  sw = switch
  st = status -sb
  undo = reset HEAD~1 --mixed
  gone = !git fetch && git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -D

[user]
	name = alxjrvs
	email = alxjrvs@gmail.com
	# The public half of the 1Password "GitHubSSH" item; ~/.ssh/allowed_signers has it too.
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKjF9JmW396EbH0n1zWeU7eT+2VvMFZAn+A1WKAi4tqT
# github.com through gh's token (what `gh auth setup-git` writes).
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[core]
	editor = nvim
	pager = delta
	untrackedCache = true

[init]
	defaultBranch = main
[commit]
	verbose = true
[push]
	autoSetupRemote = true
	followTags = true
	useForceIfIncludes = true
[pull]
	rebase = true
[rerere]
	enabled = true
	autoupdate = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	dark = true
	hyperlinks = true
[fetch]
	prune = true
	writeCommitGraph = true
[gc]
	# Agent worktrees churn daily; forget a hand-deleted one after a week, not three months.
	worktreePruneExpire = 1.week.ago

[merge]
	conflictstyle = zdiff3
[branch]
	sort = -committerdate
[column]
	ui = auto
[diff]
	algorithm = histogram
	colorMoved = dimmed-zebra
	mnemonicPrefix = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[tag]
	sort = version:refname
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[help]
	autocorrect = prompt
