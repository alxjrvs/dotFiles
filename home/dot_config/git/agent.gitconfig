# Git config for Claude Code agent sessions, included through GIT_CONFIG_KEY_0 in
# ~/.claude/settings.json so each key here overrides ~/.gitconfig for the agent only.
# Credentials are not here: github.com falls through to gh's helper in ~/.gitconfig.

# The signing key is the human's, behind Touch ID.
[commit]
	gpgSign = false
[tag]
	gpgSign = false

# HTTPS only: an SSH remote would authenticate with the human's 1Password key, which prompts.
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/

# No helper at all for gists, so an agent gist push fails closed.
[credential "https://gist.github.com"]
	helper =
