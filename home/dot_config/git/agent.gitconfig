# Git config for Claude Code agent sessions, included through GIT_CONFIG_KEY_0 in
# ~/.claude/settings.json so each key here overrides ~/.gitconfig for the agent only.

# The signing key is the human's, behind Touch ID.
[commit]
	gpgSign = false
[tag]
	gpgSign = false

# HTTPS only: an SSH remote would authenticate with the human's 1Password key.
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/

# The agent's PAT from the login keychain, pinned to its own username so the human's entry is
# never returned. Seeded once per machine; see the README.
[credential "https://github.com"]
	helper =
	helper = osxkeychain
	username = claude-agent
