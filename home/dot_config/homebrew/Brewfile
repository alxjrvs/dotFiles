# The Mac's apps, the two zsh plugins, the everyday CLIs, and three more CLIs kept as casks (1password-cli, gcloud-cli and ngrok). Runtimes are mise's; chezmoi and mise are their
# own installers' (~/.local/bin); git is Xcode's. Apply never upgrades; upkeep does, nightly, leaving
# apps that update themselves to it and quitting none. When this file changes, apply uninstalls
# whatever it does not name.

# ── zsh plugins ───────────────────────────────────────────────────────
# Scripts, not CLIs: ~/.zshrc sources them from /opt/homebrew/share.
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# ── CLIs ──────────────────────────────────────────────────────────────
# Formulae, for the zsh completions and man pages that mise's installs lack.
brew "atuin"
brew "fd"
brew "fzf"
brew "gh"
brew "jq"
brew "neovim"
brew "ripgrep"
brew "starship"

# ── 1Password CLI + desktop ───────────────────────────────────────────
cask "1password-cli"
cask "1password"

# ── Apps ──────────────────────────────────────────────────────────────
# The Claude desktop app. The Claude Code CLI is the native installer (40-provision), never brew.
cask "claude"
cask "discord"
cask "font-fira-code"
cask "ghostty"
cask "google-chrome"
cask "notunes"
cask "gcloud-cli"
cask "ngrok"
cask "obs"
cask "orbstack"      # containers: Docker's engine and CLI, for devcontainers and testcontainers
cask "raycast"       # launcher
cask "slack"
cask "tuple"
cask "visual-studio-code"
