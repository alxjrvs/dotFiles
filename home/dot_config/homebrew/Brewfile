# ~/.config/homebrew/Brewfile — the Mac's apps. Every CLI and runtime is mise's, in
# ~/.config/mise/config.toml; chezmoi is its own installer's, in ~/.local/bin; git is Xcode's.
#
# `chezmoi apply` reconciles (`brew bundle --no-upgrade`) and never upgrades: a cask upgrade
# replaces the .app and quits the running program. Upgrading an app is `brew upgrade --cask
# <name>` when it genuinely needs moving.

# ── 1Password CLI + desktop ───────────────────────────────────────────
cask "1password-cli"
cask "1password"

# ── Apps ──────────────────────────────────────────────────────────────
# The Claude desktop app. The Claude Code CLI is the native installer (run_after_50), never brew.
cask "claude"
cask "discord"
cask "font-fira-code-nerd-font"
cask "ghostty"
cask "google-chrome"
cask "notunes"
cask "devutils"      # offline developer toolbox (JSON/JWT/regex/diff)
cask "gcloud-cli"
cask "ngrok"
cask "obs"
cask "raycast"       # launcher and window management
cask "slack"
cask "tuple"
cask "visual-studio-code"
