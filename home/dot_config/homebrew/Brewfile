# ~/.config/homebrew/Brewfile — the CLIs and apps on the machine. Runtimes (node, bun) and the
# npm-built language servers are mise's, in ~/.config/mise/config.toml, so no formula here
# drags in a second node. The Claude Code CLI is the native installer (run_before_50) and git
# is Xcode's.
#
# `chezmoi apply` reconciles (`brew bundle --no-upgrade`) and never upgrades: a cask upgrade
# replaces the .app and quits the running program. Upgrading is `brew upgrade --formula`, and
# `brew upgrade --cask <name>` when an app genuinely needs moving. Each bundle run ends by
# listing what is installed but no longer declared; removing it is `brew bundle cleanup --force`.
#
# A third-party `tap` needs `trusted:` or a fresh machine stops at an interactive prompt.

# ── Bootstraps ────────────────────────────────────────────────────────
brew "mise"
brew "chezmoi"

# ── Shell ─────────────────────────────────────────────────────────────
brew "atuin"
brew "fzf"
brew "starship"
brew "zoxide"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# ── Git ───────────────────────────────────────────────────────────────
brew "gh"
brew "git-delta"
brew "lefthook"

# ── Files and text ────────────────────────────────────────────────────
brew "bat"
brew "eza"
brew "fd"
brew "jq"
brew "ripgrep"
brew "tealdeer"

# ── Editor and language servers ───────────────────────────────────────
brew "neovim"
brew "biome"
brew "marksman"
brew "shellcheck"
brew "shfmt"
brew "taplo"

# ── 1Password CLI + desktop ───────────────────────────────────────────
cask "1password-cli"
cask "1password"

# ── Apps ──────────────────────────────────────────────────────────────
# The Claude desktop app. The Claude Code CLI is the native installer (run_before_50), never brew.
cask "claude"
cask "discord"
cask "font-fira-code-nerd-font"
cask "ghostty"
cask "google-chrome"
cask "notunes"
cask "devutils"      # offline developer toolbox (JSON/JWT/regex/diff)
cask "gcloud-cli"
cask "ngrok"
cask "obs"
cask "raycast"       # launcher and window management
cask "slack"
cask "tuple"
cask "visual-studio-code"
