# ~/.config/homebrew/Brewfile — every CLI and app on the machine. Runtimes (node, bun) are
# mise's, in ~/.config/mise/config.toml.
#
# `chezmoi apply` reconciles (`brew bundle --no-upgrade`) and never upgrades: a cask upgrade
# replaces the .app and quits the running program. Upgrading is `brew upgrade --formula`, and
# `brew upgrade --cask <name>` when an app genuinely needs moving. `brew bundle cleanup` lists
# what is installed but no longer declared.
#
# A third-party `tap` needs `trusted:` or a fresh machine stops at an interactive prompt.

# ── Bootstraps ────────────────────────────────────────────────────────
brew "mise"
brew "chezmoi"

# ── Shell ─────────────────────────────────────────────────────────────
brew "atuin"
brew "fzf"
brew "starship"
brew "zoxide"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# ── Git ───────────────────────────────────────────────────────────────
brew "delta"
brew "gh"
brew "gitleaks"
brew "lefthook"

# ── Files and text ────────────────────────────────────────────────────
brew "bat"
brew "eza"
brew "fd"
brew "jq"
brew "ripgrep"
brew "tealdeer"

# ── Editor and language servers ───────────────────────────────────────
brew "neovim"
brew "bash-language-server"
brew "biome"
brew "marksman"
brew "shellcheck"
brew "shfmt"
brew "taplo"
brew "typescript-language-server"

# ── 1Password CLI + desktop ───────────────────────────────────────────
cask "1password-cli"
cask "1password"

# ── Apps ──────────────────────────────────────────────────────────────
# The Claude desktop app. The Claude Code CLI is the native installer (run_after_50), never brew.
cask "claude"
cask "discord"
cask "font-fira-code-nerd-font"
cask "ghostty"
cask "google-chrome"
# Caps Lock → Control; config at home/dot_config/karabiner/. Karabiner rewrites that file when
# edited in its UI: `chezmoi re-add ~/.config/karabiner/karabiner.json` afterwards.
cask "karabiner-elements"
cask "notunes"
cask "devutils"      # offline developer toolbox (JSON/JWT/regex/diff)
cask "gcloud-cli"
cask "ngrok"
cask "obs"
cask "raycast"
cask "rectangle"
cask "slack"
cask "tuple"
