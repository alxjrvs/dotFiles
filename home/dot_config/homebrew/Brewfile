# ~/.config/homebrew/Brewfile — casks, system libs, the two bootstrap formulae, and the few
# CLIs brew owns on this machine. A new CLI belongs in ~/.config/mise/config.toml instead.
#
# ── Upgrading is three commands, and `chezmoi apply` is not one of them ──────────────
#
#   chezmoi apply            # reconcile only — `brew bundle --no-upgrade`, `mise install`
#   brew upgrade --formula   # every outdated formula. Cannot touch a cask.
#   mise upgrade --bump      # what actually moves the CLIs (rewrites the pins — commit them)
#
# Reconciling answers "is what I declared installed?", never "is what is installed current?".
# `brew bundle` without `--no-upgrade` upgrades CASKS as well as formulae whatever `greedy`
# says, and a cask upgrade replaces the `.app`, so Homebrew quits the running program —
# Chrome, Slack, Ghostty, 1Password — to deliver formulae that `brew upgrade --formula`
# delivers without closing anything.
#
# Casks are left to their own updaters, which Chrome, Slack, Discord, 1Password, Raycast and
# the rest all ship; brew's version record for a self-updating app is fiction, and pushing
# it over the app forces a restart to deliver nothing. When a cask genuinely needs moving:
# `brew upgrade --cask <name>`.
#
# `brew bundle` never uninstalls: undeclaring a package here is half of removing it, and
# `brew bundle cleanup` (dry run by default) lists the other half.

# A third-party `tap` line needs `trusted:` — brew refuses to load an untrusted tap until
# someone runs `brew trust` by hand, which is a fresh machine stopping halfway.
brew "mise"
brew "chezmoi"

# GNU coreutils for `timeout`, which the Stop hook uses and macOS does not ship.
brew "coreutils"

# ── 1Password CLI + desktop ───────────────────────────────────────────
cask "1password-cli"
cask "1password"

# ── Apps ──────────────────────────────────────────────────────────────
# cask "claude" is the Claude desktop GUI app, NOT the CLI (it ships no `claude` binary on
# PATH, so it coexists with the native CLI). The Claude Code CLI comes from the native curl
# installer (home/run_after_00-claude-cli.sh.tmpl), which self-updates — never install it
# via brew (cask "claude-code") or npm.
cask "claude"
cask "discord"

# ── Fonts ─────────────────────────────────────────────────────────────
cask "font-fira-code-nerd-font"

# ── Terminal ──────────────────────────────────────────────────────────
cask "ghostty"

cask "google-chrome"

# Key remapping (Caps Lock → Control); config tracked at home/dot_config/karabiner/. Karabiner
# rewrites that file when edited in its UI: `chezmoi re-add ~/.config/karabiner/karabiner.json`.
cask "karabiner-elements"

cask "notunes"

cask "devutils"      # offline developer toolbox (JSON/JWT/regex/diff)
cask "gcloud-cli"    # Google Cloud SDK
cask "ngrok"         # public tunnel to a local port
cask "obs"           # screen recording
cask "raycast"       # launcher + clipboard (its window management overlaps rectangle)
cask "rectangle"     # window management
cask "slack"
cask "tuple"
