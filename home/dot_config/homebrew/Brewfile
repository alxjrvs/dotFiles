# The Mac's apps, its one service, and three CLIs kept as casks (1password-cli, gcloud-cli and
# ngrok); every other CLI is mise's. chezmoi and mise are their own installers' (~/.local/bin);
# git is Xcode's. Apply never upgrades (a cask upgrade quits the running app): `brew upgrade
# --cask <name>` when it must. When this file changes, apply uninstalls whatever it does not name.

# ── Services ──────────────────────────────────────────────────────────
# A launchd service, not a CLI: apply starts it and restarts it when the formula changes, and
# `link` puts the keg-only psql on PATH.
brew "postgresql@17", restart_service: :changed, link: true

# ── 1Password CLI + desktop ───────────────────────────────────────────
cask "1password-cli"
cask "1password"

# ── Apps ──────────────────────────────────────────────────────────────
# The Claude desktop app. The Claude Code CLI is the native installer (40-provision), never brew.
cask "claude"
cask "discord"
cask "font-fira-code"
cask "ghostty"
cask "google-chrome"
cask "notunes"
cask "devutils"      # offline developer toolbox (JSON/JWT/regex/diff)
cask "gcloud-cli"
cask "ngrok"
cask "obs"
cask "orbstack"      # containers: Docker's engine and CLI, for devcontainers and testcontainers
cask "raycast"       # launcher
cask "slack"
cask "tuple"
cask "visual-studio-code"
