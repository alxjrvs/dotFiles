# The R9700's starting point for noise, to tune by ear. maia-gpu-tune applies it through LACT:
# the power cap every run, the fan curve once, into /etc/lact/config.yaml under the GPU's real id
# (LACT keys each GPU by its PCI ids and slot). After that, LACT's window is the place to tune.
#
# The power cap is maia.powerCap from ~/.config/chezmoi/chezmoi.toml. RDNA3 and later take exactly
# five curve points, speed 0 to 1, and a custom curve needs overdrive (maia.ppfeaturemask).
# A blower is loud at any speed: these hold it low until the card is genuinely warm.
gpus:
  "GPU_ID": # maia-gpu-tune puts these under the id `lact cli list` prints
    power_cap: {{ dig "maia" "powerCap" 230 . }}.0
    performance_level: auto
    fan_control_enabled: true
    fan_control_settings:
      mode: curve
      temperature_key: edge
      interval_ms: 500
      # Hysteresis: no spin-down for 5 s, and nothing under a 2 °C change, so the blower does not hunt.
      spindown_delay_ms: 5000
      change_threshold: 2
      curve:
        50: 0.25
        60: 0.32
        70: 0.42
        80: 0.6
        90: 0.85
