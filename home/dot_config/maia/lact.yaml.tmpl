# A starting point for the R9700's noise, to tune by ear: nothing applies this file. LACT keys each
# GPU by its PCI ids and slot, which exist only once the card is in, so the block goes into
# /etc/lact/config.yaml by hand under `gpus:` (MAIA.md has the steps), or the same values go in
# through LACT's window.
#
# The power cap is maia.powerCap from ~/.config/chezmoi/chezmoi.toml. RDNA3 and later take exactly
# five curve points, speed 0 to 1, and a custom curve needs amdgpu.ppfeaturemask (maia.ppfeaturemask).
# A blower is loud at any speed: these hold it low until the card is genuinely warm.
gpus:
  "GPU_ID": # from `lact cli list-gpus`, e.g. 1002:7551-1458:xxxx-0000:03:00.0
    power_cap: {{ dig "maia" "powerCap" 230 . }}.0
    performance_level: auto
    fan_control_enabled: true
    fan_control_settings:
      mode: curve
      temperature_key: edge
      interval_ms: 500
      # Hysteresis: no spin-down for 5 s, and nothing under a 2 °C change, so the blower does not hunt.
      spindown_delay_ms: 5000
      change_threshold: 2
      curve:
        50: 0.25
        60: 0.32
        70: 0.42
        80: 0.6
        90: 0.85
