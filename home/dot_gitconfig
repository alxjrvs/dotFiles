[alias]
  hist = log --graph --pretty=format:'%Cred%h%Creset %s%C(yellow)%d%Creset %Cgreen(%cr)%Creset [%an]' --abbrev-commit --date=relative
  sw = switch
  st = status -sb
  undo = reset HEAD~1 --mixed
  gone = !git fetch && git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -D

[user]
	name = alxjrvs
	email = alxjrvs@gmail.com
	# user.signingkey is in ~/.gitconfig.local, written by scripts/git-signing.ts.
[credential]
	helper = osxkeychain
# GitHub HTTPS auth via the gh CLI (keychain-backed). Lets git push resolve a
# token on demand instead of needing a PAT in the environment. The empty
# `helper =` resets the inherited osxkeychain helper for github.com so gh is
# used. Mirrors `gh auth setup-git`.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[core]
	editor = nvim
	pager = delta
	untrackedCache = true

# Repos that predate the template: cp ~/.config/git/template/hooks/pre-commit <repo>/.git/hooks/
[init]
	defaultBranch = main
	templateDir = ~/.config/git/template
[commit]
	template = ~/.gitmessage
	verbose = true
	gpgSign = true
[push]
	autoSetupRemote = true
	followTags = true
	useForceIfIncludes = true
[pull]
	rebase = true
[rerere]
	enabled = true
	autoupdate = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	dark = true
	hyperlinks = true
[transfer]
	# Verify object connectivity/validity on receive. This repo signs commits and
	# checksums every tool in mise.lock; accepting malformed objects unchecked was
	# the one unguarded edge.
	fsckObjects = true

[fetch]
	fsckObjects = true
	prune = true
	pruneTags = true
	writeCommitGraph = true
[gc]
	# `git worktree list` keeps listing a worktree whose directory was deleted by
	# hand (git marks it `prunable`), because that metadata is only cleared during
	# gc and the default grace period is 3 months. Agent worktrees churn daily here,
	# so a week is the honest expiry. Measured with a control: at the default the
	# metadata survives `git gc`; with an elapsed expiry gc removes it — and
	# refs/heads/<branch> survives either way, so this can only drop bookkeeping for
	# a directory that is already gone, never a live worktree and never a commit.
	worktreePruneExpire = 1.week.ago

[merge]
	conflictstyle = zdiff3
[branch]
	sort = -committerdate
[column]
	ui = auto
[diff]
	algorithm = histogram
	colorMoved = dimmed-zebra
	mnemonicPrefix = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[tag]
	sort = version:refname
	gpgSign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
	# Constant, so tracked here; scripts/git-signing.ts writes only user.signingkey.
	# Agent sessions turn signing off via GIT_CONFIG_KEY_0 in home/dot_claude/settings.json.
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[help]
	autocorrect = prompt
[include]
	path = ~/.gitconfig.local
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
