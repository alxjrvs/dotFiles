[alias]
  hist = log --oneline --graph --decorate
  sw = switch
  st = status -sb
  undo = reset HEAD~1 --mixed
  gone = !git fetch && git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -D

[user]
	name = alxjrvs
	email = alxjrvs@gmail.com
	# The public half of the 1Password "GitHubSSH" item, offered identically on every machine by
	# the agent named under [gpg "ssh"]. ~/.ssh/allowed_signers carries the same key so
	# `git log --show-signature` verifies locally.
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKjF9JmW396EbH0n1zWeU7eT+2VvMFZAn+A1WKAi4tqT
[credential]
	helper = osxkeychain
# GitHub HTTPS auth via the gh CLI (keychain-backed). Lets git push resolve a
# token on demand instead of needing a PAT in the environment. The empty
# `helper =` resets the inherited osxkeychain helper for github.com so gh is
# used. Mirrors `gh auth setup-git`.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[core]
	editor = nvim
	pager = delta
	untrackedCache = true

[init]
	defaultBranch = main
[commit]
	verbose = true
	gpgSign = true
[push]
	autoSetupRemote = true
	followTags = true
	useForceIfIncludes = true
[pull]
	rebase = true
[rerere]
	enabled = true
	autoupdate = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	dark = true
	hyperlinks = true
[fetch]
	prune = true
	writeCommitGraph = true
[gc]
	# Agent worktrees churn daily; drop the bookkeeping for a hand-deleted one after a week
	# instead of git's three months. Only metadata for a directory already gone, never a ref.
	worktreePruneExpire = 1.week.ago

[merge]
	conflictstyle = zdiff3
[branch]
	sort = -committerdate
[column]
	ui = auto
[diff]
	algorithm = histogram
	colorMoved = dimmed-zebra
	mnemonicPrefix = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[tag]
	sort = version:refname
	gpgSign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
	# Agent sessions turn signing off in ~/.config/git/agent.gitconfig.
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[help]
	autocorrect = prompt
