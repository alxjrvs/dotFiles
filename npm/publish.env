# npm publish credentials — 1Password secret references only, never values.
#
# `~/.npmrc` carries `_authToken=${NPM_TOKEN}`, which npm expands at read time.
# Nothing defined NPM_TOKEN, so `op run -- npm publish` injected nothing and npm
# read an empty token (measured 2026-08-19). The storage side was always correct;
# the RESOLUTION side was never wired. This file is that wiring.
#
#   op run --env-file=npm/publish.env -- npm publish
#
# `op run` resolves the reference in-process, injects it into the child's
# environment, and masks the value if the child prints it. Nothing is written to
# disk and nothing reaches the session environment, so a daily `npm install`
# (which needs no token) stays credential-free.
#
# This file is safe to commit: it holds a reference, not a secret.
NPM_TOKEN=op://claude-agent/npm-publish-token/credential
