{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!home/dot_config/karabiner/karabiner.json"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "overrides": [
    {
      "includes": ["home/dot_claude/settings.json"],
      "json": {
        "formatter": {
          "expand": "always"
        }
      }
    }
  ]
}
