{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash",
      "PowerShell",
      "Agent",
      "Artifact",
      "Edit",
      "EnterWorktree",
      "KillShell",
      "Monitor",
      "NotebookEdit",
      "TaskCreate",
      "TaskStop",
      "TaskUpdate",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "Write",
      "mcp__*"
    ],
    "defaultMode": "plan"
  },
  "autoMode": {
    "classifyAllShell": true
  }
}
