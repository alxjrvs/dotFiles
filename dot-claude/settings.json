{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "GIT_AUTHOR_NAME": "Claude",
    "GIT_AUTHOR_EMAIL": "alxjrvs+claude@gmail.com",
    "GIT_COMMITTER_NAME": "Claude",
    "GIT_COMMITTER_EMAIL": "alxjrvs+claude@gmail.com",
    "GIT_CONFIG_COUNT": "5",
    "GIT_CONFIG_KEY_0": "commit.gpgsign",
    "GIT_CONFIG_VALUE_0": "false",
    "GIT_CONFIG_KEY_1": "tag.gpgsign",
    "GIT_CONFIG_VALUE_1": "false",
    "GIT_CONFIG_KEY_2": "credential.https://github.com.helper",
    "GIT_CONFIG_VALUE_2": "",
    "GIT_CONFIG_KEY_3": "credential.https://github.com.helper",
    "GIT_CONFIG_VALUE_3": "cache --timeout=900",
    "GIT_CONFIG_KEY_4": "credential.https://github.com.helper",
    "GIT_CONFIG_VALUE_4": "!~/.local/bin/op-agent git-credential",
    "SPACEBASE_API_KEY_COMMAND": "~/.local/bin/op-agent secret \"op://claude-agent/spacebase-api-key/credential\"",
    "SPACEBASE_API_KEY": "",
    "SPACEBASE_URL": "",
    "SPACEBASE_PROJECT_ID": "",
    "NINETY_API_TOKEN_COMMAND": "~/.local/bin/op-agent secret \"op://claude-agent/gninety/credential\"",
    "NINETY_API_TOKEN": "",
    "NINETY_BASE_URL": ""
  },
  "attribution": {
    "commit": "Co-Authored-By: alxjrvs <alxjrvs@gmail.com>"
  },
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)",
      "Bash(gh stack merge:*)"
    ],
    "deny": [
      "Bash(security find-generic-password:*)",
      "Bash(op-agent secret:*)",
      "Bash(~/.local/bin/op-agent secret:*)",
      "Bash(op read:*)",
      "Bash(op item get:*)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "command -v caffeinate >/dev/null 2>&1 && (caffeinate -i -w $PPID >/dev/null 2>&1 &) || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-checkout-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/rebase-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pr-review.sh",
            "if": "Bash(gh pr create:*)"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pr-review.sh",
            "if": "Bash(git push:*)"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pr-review.sh",
            "if": "Bash(gh stack submit:*)"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/claude-statusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.local/bin/claude-subagent-statusline"
  },
  "enabledPlugins": {
    "audit@gnar": true,
    "ignite@gnar": true,
    "spacebase@gnar": true,
    "gninety@gnar": true,
    "typescript-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "expo@claude-plugins-official": true,
    "binfinite-context@binfinite": true
  },
  "extraKnownMarketplaces": {
    "gnar": {
      "source": {
        "source": "github",
        "repo": "TheGnarCo/agent-skills"
      },
      "autoUpdate": true
    },
    "binfinite": {
      "source": {
        "source": "github",
        "repo": "BinfiniteLLC/binfinite-app"
      },
      "autoUpdate": true
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "verbose": true,
  "autoScrollEnabled": true,
  "showTurnDuration": false,
  "terminalProgressBarEnabled": false,
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "classifyAllShell": true
  },
  "voiceEnabled": true
}
