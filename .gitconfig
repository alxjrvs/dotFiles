[alias]
  # Pretty log output
  hist = log --graph --pretty=format:'%Cred%h%Creset %s%C(yellow)%d%Creset %Cgreen(%cr)%Creset [%an]' --abbrev-commit --date=relative
  sw = switch
  st = status -sb
  undo = reset HEAD~1 --mixed
  gone = !git fetch -p && git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -D

[user]
	name = alxjrvs
	email = alxjrvs@gmail.com
	# user.signingkey is machine-local (~/.gitconfig.local, written by
	# `boom source` (git-signing hook)) -- a `key::` pubkey for the 1Password
	# "GitHubSSH" key. git signs via op-ssh-sign (1Password), no local key.
[credential]
	helper = osxkeychain
# GitHub HTTPS auth via the gh CLI (keychain-backed). Lets git push resolve a
# token on demand instead of needing a PAT in the environment. The empty
# `helper =` resets the inherited osxkeychain helper for github.com so gh is
# used. Mirrors `gh auth setup-git`.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[core]
	editor = nvim
	# No excludesfile override: git reads ~/.config/git/ignore (XDG default)
	# for global excludes, managed by the `git/ignore` link in boomfile.toml.
	# The repo's own .gitignore stays repo-scoped (it used to double as the
	# global excludes via a ~/.gitignore symlink, leaking .claude/ etc. into
	# every repo on the machine).
	pager = delta
	untrackedCache = true

# New repos copy template/hooks/pre-commit into their own .git/hooks/ at
# `git init`/`git clone` time → gitleaks runs per-repo without conflicting
# with lefthook (which owns .git/hooks/pre-commit in lefthook-equipped repos).
# Repos that predate the template need a one-shot:
#   cp ~/.config/git/template/hooks/pre-commit <repo>/.git/hooks/pre-commit
[init]
	defaultBranch = main
	templateDir = ~/.config/git/template
[commit]
	template = ~/.gitmessage
	verbose = true
	gpgSign = true
	# Anything below the scissors line in the commit message is stripped.
	cleanup = scissors
[push]
	autoSetupRemote = true
	followTags = true
	useForceIfIncludes = true
[pull]
	rebase = true
[rerere]
	enabled = true
	autoupdate = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	dark = true
	hyperlinks = true
[transfer]
	# Verify object connectivity/validity on receive. This repo signs commits and
	# checksums every tool in mise.lock; accepting malformed objects unchecked was
	# the one unguarded edge.
	fsckObjects = true

[fetch]
	fsckObjects = true
	prune = true
	pruneTags = true
	writeCommitGraph = true
[gc]
	# `git worktree list` keeps listing a worktree whose directory was deleted by
	# hand (git marks it `prunable`), because that metadata is only cleared during
	# gc and the default grace period is 3 months. Agent worktrees churn daily here,
	# so a week is the honest expiry. Measured with a control: at the default the
	# metadata survives `git gc`; with an elapsed expiry gc removes it — and
	# refs/heads/<branch> survives either way, so this can only drop bookkeeping for
	# a directory that is already gone, never a live worktree and never a commit.
	worktreePruneExpire = 1.week.ago

[merge]
	conflictstyle = zdiff3
[branch]
	sort = -committerdate
[column]
	ui = auto
[diff]
	algorithm = histogram
	colorMoved = dimmed-zebra
	mnemonicPrefix = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[tag]
	sort = version:refname
	gpgSign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
	# Constants, so they live here rather than being written into
	# ~/.gitconfig.local by hooks/git-signing.ts on every sync. That hook keeps
	# only the one value it has to DISCOVER — user.signingkey, looked up by key
	# name from the 1Password agent, so a rotated key converges without an edit.
	#
	# They were machine-local on the reasoning that "a box without 1Password
	# shouldn't fail commits". That is host detection wearing another name, and
	# it guards a machine this config does not support anyway: README ranks
	# 1Password second in what breaks on a fork, and `boom verify` fails on day
	# one without it. Agent sessions still turn signing off explicitly, via
	# GIT_CONFIG_KEY_0 in dot-claude/settings.json.
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[help]
	autocorrect = prompt
[include]
	path = ~/.gitconfig.local
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
