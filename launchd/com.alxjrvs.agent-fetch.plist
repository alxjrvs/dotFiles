<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.alxjrvs.agent-fetch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-l</string>
		<string>-c</string>
		<string>for g in ~/Code/*/*/.git(N) ~/Code/*/.git(N); do [ -d "$g" ] &amp;&amp; git -C "${g%/.git}" fetch --quiet --prune 2>/dev/null; done; true</string>
	</array>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>~/Library/Logs/agent-fetch.log</string>
	<key>StandardErrorPath</key>
	<string>~/Library/Logs/agent-fetch.log</string>
</dict>
</plist>
