<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.alxjrvs.boom-verify</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-l</string>
		<string>-c</string>
		<string>boom verify || osascript -e 'display notification "settings.json or config drift detected — run boom verify" with title "boom verify"'</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>21</integer>
		<key>Minute</key>
		<integer>47</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<!-- Absolute paths only: launchd does NOT expand ~ or $HOME in plist values.
	     A ~-prefixed log path fails the job with EX_CONFIG (exit 78) before it
	     runs, which is exactly what happened here: this job reported runs=0 from
	     2026-07-10 to 2026-08-08 and never once executed. The identical bug was
	     found and fixed in com.alxjrvs.capslock-control.plist on 2026-07-13 (#63)
	     and not carried across to its neighbour, so every `boom verify` guardrail
	     — the deny floor, the Fable-default drift check, the MCP auto-approve
	     check, the dirty-config-repo check and op-agent's SA-token expiry warning
	     — sat un-run for 28 days while `notify = true` never fired.
	     lint.yml and lefthook now both fail on a ~ in any plist path value. -->
	<key>StandardOutPath</key>
	<string>/tmp/boom-verify.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/boom-verify.log</string>
</dict>
</plist>
