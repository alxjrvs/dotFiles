# Claude — `.claude/` itself is checked in (project skills, rules, etc. are
# shared/reviewed like any other repo content). Only the machine-local pieces
# under it are excluded: worktrees (isolated session checkouts) and
# settings.local.json (below). User/global config lives in `dot-claude/`,
# symlinked into ~/.claude/ by `botu apply`.
.claude/worktrees/

# Transient/generated
Brewfile.lock.json

# Generated audit reports (gnar audit plugin) — regenerate on demand, not tracked.
audit/

# Machine-specific overrides
dot-claude/settings.local.json
**/.claude/settings.local.json
