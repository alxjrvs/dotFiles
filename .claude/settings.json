{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(*git push origin main*)",
      "Bash(*git push -u origin main*)",
      "Bash(*git push origin HEAD:main*)"
    ]
  },
  "extraKnownMarketplaces": {
    "oberon": {
      "source": {
        "source": "github",
        "repo": "alxjrvs/oberon"
      }
    }
  },
  "enabledPlugins": {
    "agent-friendly-repo@oberon": true
  },
  "attribution": {
    "sessionUrl": false
  }
}
